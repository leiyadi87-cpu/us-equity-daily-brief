<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>{{ title }}</title></head>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,'Segoe UI','PingFang SC','Microsoft YaHei',Helvetica,Arial,sans-serif;color:#1f2328;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;"><tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="680" cellpadding="0" cellspacing="0" style="max-width:680px;width:100%;background:#ffffff;border-radius:10px;overflow:hidden;">

  <tr><td style="background:#0b1f3a;color:#ffffff;padding:22px 28px;">
    <div style="font-size:12px;letter-spacing:1px;opacity:.7;text-transform:uppercase;">{{ t.kicker }}</div>
    <div style="font-size:22px;font-weight:700;margin-top:4px;">{{ title }}</div>
    <div style="font-size:13px;opacity:.8;margin-top:6px;">{{ t.as_of }} {{ as_of }}{% if demo %} · <b style="color:#ffcc66;">DEMO DATA</b>{% endif %}</div>
  </td></tr>

  <!-- market snapshot -->
  <tr><td style="padding:20px 28px 4px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
    {% for r in snapshot %}
      <td width="{{ (100 / snapshot|length)|int }}%" style="padding:4px;">
        <div style="border:1px solid #e5e7eb;border-radius:8px;padding:10px 12px;">
          <div style="font-size:12px;color:#6b7280;">{{ r.name }}</div>
          <div style="font-size:18px;font-weight:700;margin-top:2px;">{{ "%.2f"|format(r.close) }}</div>
          <div style="font-size:13px;font-weight:600;color:{{ color(r.ret_1d, r.ticker) }};">{{ pct(r.ret_1d) }}</div>
        </div>
      </td>
    {% endfor %}
    </tr></table>
  </td></tr>

  <!-- AI brief -->
  <tr><td style="padding:12px 28px 8px;font-size:14px;line-height:1.65;">
    {{ summary_html }}
    <div style="font-size:11px;color:#9ca3af;margin-top:6px;">{{ t.written_by }} {{ source }}</div>
  </td></tr>

  <!-- sector scoreboard -->
  <tr><td style="padding:8px 28px;">
    <div style="font-size:16px;font-weight:700;margin:8px 0;">{{ t.sectors }}</div>
    <table role="presentation" width="100%" cellpadding="6" cellspacing="0" style="border-collapse:collapse;font-size:13px;">
      <tr style="background:#f3f4f6;color:#6b7280;text-align:right;">
        <th align="left">{{ t.sector }}</th><th>1D</th><th>5D</th><th>1M</th><th>YTD</th></tr>
      {% for s in sectors %}
      <tr style="border-bottom:1px solid #f0f0f0;text-align:right;">
        <td align="left">{{ s.name }}<span style="color:#9ca3af;font-size:11px;"> {{ s.basis }}</span></td>
        {% for k in ['ret_1d','ret_5d','ret_1m','ret_ytd'] %}
        <td style="color:{{ color(s[k]) }};background:{{ heat(s[k], k) }};">{{ pct(s[k]) }}</td>
        {% endfor %}
      </tr>
      {% endfor %}
    </table>
  </td></tr>

  <!-- detail tables -->
  {% for g in groups %}
  <tr><td style="padding:10px 28px 4px;">
    <div style="font-size:14px;font-weight:700;margin:10px 0 6px;color:#0b1f3a;">{{ g.name }}</div>
    <table role="presentation" width="100%" cellpadding="5" cellspacing="0" style="border-collapse:collapse;font-size:12px;">
      <tr style="color:#6b7280;text-align:right;border-bottom:1px solid #e5e7eb;">
        <th align="left">{{ t.ticker }}</th><th>{{ t.close }}</th><th>1D</th><th>5D</th><th>1M</th><th>YTD</th><th>RSI</th><th>vs200D</th><th>{{ t.vol }}</th></tr>
      {% for r in g.rows %}
      <tr style="text-align:right;border-bottom:1px solid #f5f5f5;">
        <td align="left"><b>{{ r.ticker }}</b>{% if r.name != r.ticker %} <span style="color:#6b7280;">{{ r.name }}</span>{% endif %}</td>
        <td>{{ "%.2f"|format(r.close) }}</td>
        {% for k in ['ret_1d','ret_5d','ret_1m','ret_ytd'] %}<td style="color:{{ color(r[k], r.ticker) }};">{{ pct(r[k]) }}</td>{% endfor %}
        <td style="{% if r.rsi14 >= 70 %}color:#b45309;font-weight:700;{% elif r.rsi14 <= 30 %}color:#2563eb;font-weight:700;{% endif %}">{{ "%.0f"|format(r.rsi14) }}</td>
        <td>{{ pct(r.vs_sma200) }}</td>
        <td style="{% if r.vol_ratio >= 2 %}font-weight:700;{% endif %}">{{ volx(r.vol_ratio) }}</td>
      </tr>
      {% endfor %}
    </table>
  </td></tr>
  {% endfor %}

  <!-- news -->
  {% if news %}
  <tr><td style="padding:16px 28px 8px;">
    <div style="font-size:16px;font-weight:700;margin:8px 0;">{{ t.news }}</div>
    {% for n in news %}
    <div style="font-size:13px;margin:6px 0;line-height:1.45;">
      <span style="display:inline-block;background:#eef2ff;color:#3730a3;border-radius:4px;padding:1px 6px;font-size:11px;font-weight:600;">{{ n.ticker }}</span>
      {% if n.url %}<a href="{{ n.url }}" style="color:#1f2328;text-decoration:none;">{{ n.title }}</a>{% else %}{{ n.title }}{% endif %}
      <span style="color:#9ca3af;font-size:11px;"> {{ n.publisher }}</span>
    </div>
    {% endfor %}
  </td></tr>
  {% endif %}

  <tr><td style="padding:18px 28px 24px;font-size:11px;color:#9ca3af;line-height:1.5;border-top:1px solid #f0f0f0;">
    {{ t.footer }}{% if missing %}<br>{{ t.missing }} {{ missing|join(', ') }}{% endif %}
  </td></tr>
</table>
</td></tr></table>
</body></html>
